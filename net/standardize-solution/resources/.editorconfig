root = true

########################################
# Global settings
########################################

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
max_line_length = 100

[*.{cs,vb}]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

[*.csproj]
indent_size = 2

[*.json]
indent_size = 2

[*.config]
indent_size = 2